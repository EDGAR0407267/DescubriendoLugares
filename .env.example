# Copy to .env.local and fill in. Never commit real values.

# Public canonical origin, no trailing slash. Used for canonical URLs,
# hreflang, Open Graph, sitemaps and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines may index the site only when this is exactly "true".
# Keep it unset/false on local, preview and staging environments.
ALLOW_INDEXING=false

# Public identity. Leave empty until the owner provides real, reviewed values.
# All four are required by the indexing launch gate. Rebuild after changing them.
PUBLISHER_LEGAL_NAME=
PUBLISHER_TAX_ID=
PUBLISHER_ADDRESS=
PUBLISHER_EMAIL=
# Optional comma-separated HTTPS profiles and X handle; no fictitious accounts.
PUBLISHER_SOCIAL_URLS=
PUBLISHER_TWITTER_HANDLE=

# Data source: "supabase" or "embedded".
#   supabase  → reads from your Supabase project (required in production)
#   embedded  → in-process Postgres (PGlite) loaded with supabase/migrations
#               and supabase/seed.sql. Zero setup, for development and CI.
# When unset: "supabase" if SUPABASE_URL and SUPABASE_ANON_KEY are set,
# otherwise "embedded".
DATA_SOURCE=

# Supabase (Project Settings → API). Server-side only: the browser never
# talks to Supabase in this phase, so these are NOT prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared secret for POST /api/revalidate (content cache invalidation after
# editing data in Supabase). At least 32 characters.
REVALIDATE_SECRET=

# Search engine verification (optional; DNS verification needs no variable).
# Paste only the `content` value of the meta tag. Never commit real tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty = no analytics at
# all. Loaded lazily with Consent Mode denied by default: add a consent
# banner before relying on full measurement (see docs/SEO.md).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Never set SUPABASE_SERVICE_ROLE_KEY in this app. It is only needed by
# future admin tooling and must not be exposed to the web runtime.
